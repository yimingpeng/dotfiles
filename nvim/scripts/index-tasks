#!/usr/bin/env bash
# index-tasks index-note.md
# Mimics the Dataview query inside your index notes:
#     TASK WHERE icontains(text, this.file.name) AND icontains(text, "#log/work")
#     GROUP BY file.name SORT filename desc
# i.e. every checkbox line (any status, incl. [n]) in the vault that contains the index note's
# own name AND every #tag named in that note's icontains(text, "#...") conditions.
# Tags are read from the note itself, so each index note keeps its own query.
# Output: file:line:col:text, grouped by filename, newest filename first (quickfix-ready).
# ponytail: shows the task line only, not its indented child bullets. Upgrade: print children too.
set -euo pipefail
VAULT="${VAULT:-$HOME/vault}"
F="${1:?usage: index-tasks index-note.md}"
NAME="$(basename "$F" .md)"

TAGS="$(rg -o --no-filename 'icontains\(text, *"#[^"]+"\)' "$F" | sed -E 's/.*"(#[^"]+)".*/\1/' | paste -sd'|' - || true)"
[ -n "$TAGS" ] || { echo "no icontains(text, \"#tag\") query found in $F" >&2; exit 0; }

TAB="$(printf '\t')"
rg --vimgrep --no-heading --glob '*.md' --glob '!_templates/**' --glob '!**/Templates/**' \
   -e '^\s*[-*+] \[.\] ' -- "$VAULT" |
awk -v name="$NAME" -v tags="$TAGS" '
  BEGIN { name = tolower(name); n = split(tolower(tags), T, "|") }
  {
    text = $0; sub(/^[^:]*:[0-9]+:[0-9]+:/, "", text); text = tolower(text)   # match the line text only, not the path
    if (index(text, name) == 0) next
    ok = 1
    for (i = 1; i <= n; i++) if (index(text, T[i]) == 0) { ok = 0; break }
    if (!ok) next
    split($0, P, ":"); base = P[1]; sub(/^.*\//, "", base)
    print base "\t" P[2] "\t" $0
  }
' | sort -t "$TAB" -k1,1r -k2,2n | cut -f3-
