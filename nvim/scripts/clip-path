#!/usr/bin/env bash
# clip-path [file]
# Copy the file's path to the Windows clipboard so you can paste it into an Outlook event.
# In WSL this is the \\wsl$\... UNC path (wslpath -w). Override the clipboard tool with CLIP_CMD.
set -euo pipefail
F="${1:?usage: clip-path note.md}"
ABS="$(cd "$(dirname "$F")" && pwd)/$(basename "$F")"
if command -v wslpath >/dev/null 2>&1; then OUT="$(wslpath -w "$ABS")"; else OUT="$ABS"; fi
CLIP="${CLIP_CMD:-}"
if [ -z "$CLIP" ]; then
  if command -v clip.exe >/dev/null 2>&1; then CLIP="clip.exe"
  elif command -v pbcopy >/dev/null 2>&1; then CLIP="pbcopy"
  else echo "$OUT"; exit 0; fi
fi
printf '%s' "$OUT" | $CLIP
echo "copied: $OUT" >&2
