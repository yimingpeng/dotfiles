#!/usr/bin/env bash
# meetings [YYYY-MM-DD]
# Notes tagged log/meeting that link to the daily note [[DAY]] (default today).
# Replaces the "Meeting Notes" Dataview query. Output: file:1:1:title (quickfix-ready).
set -euo pipefail
VAULT="${VAULT:-$HOME/vault}"
DAY="${1:-$(date +%F)}"
rg -l --glob '*.md' --glob '!_templates/**' --glob '!**/Templates/**' --glob '!000 - Daily Notes/**' \
   -F "[[$DAY]]" "$VAULT" |
while IFS= read -r f; do
  if rg -q 'log/meeting' "$f"; then echo "$f:1:1:$(basename "$f" .md)"; fi
done
