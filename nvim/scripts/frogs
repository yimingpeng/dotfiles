#!/usr/bin/env bash
# frogs [YYYY-MM-DD]
# Unchecked #task/frog (or #frog) lines from the daily note of the day BEFORE DAY (default: yesterday).
# Replaces the "Yesterday's Frogs" Dataview TASK query in your daily template.
set -euo pipefail
VAULT="${VAULT:-$HOME/vault}"
DAYS="${DAILY_DIR:-000 - Daily Notes}"
if [ $# -ge 1 ]; then BASE="$1"; else BASE="$(date +%F)"; fi
# GNU date (WSL/Linux) first, BSD date (macOS) as fallback
PREV="$(date -d "$BASE -1 day" +%F 2>/dev/null || date -j -v-1d -f %F "$BASE" +%F)"
F="$VAULT/$DAYS/$PREV.md"
[ -f "$F" ] || { echo "no daily note: $F" >&2; exit 0; }
rg --vimgrep --no-heading -e '^\s*- \[ \] .*#(task/)?frog' "$F" || true
